# Postgres local (docker compose up -d) — usado a partir da etapa 2
DENSITY_DATABASE_URL=postgresql://density:density@localhost:5432/density

# Chaves de API — necessárias a partir da etapa 2 (embeddings) e 4 (geração)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Overrides opcionais de embedding (defaults abaixo)
# DENSITY_EMBEDDING_MODEL=text-embedding-3-small
# DENSITY_EMBEDDING_DIMENSIONS=1536
